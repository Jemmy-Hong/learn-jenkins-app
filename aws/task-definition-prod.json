{
  "requiresCompatibilities": ["FARGATE"],
  "family": "LearnJenkinsApp-TaskDefinition-Prod",
  "containerDefinitions": [
    {
      "name": "learnjenkinsapp",
      "image": "650708167380.dkr.ecr.ap-southeast-1.amazonaws.com/eks-devops:#APP_VERSION#",
      "portMappings": [
        {
          "name": "ngnix-80-tcp",
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true
    }
  ],
  "volumes": [],
  "networkMode": "awsvpc",
  "memory": "512",
  "cpu": "256",
  "executionRoleArn": "arn:aws:iam::650708167380:role/ecsTaskExecutionRole"
}
